<Project>

  <!--
    Local machine paths. Override per-machine by creating Directory.Build.props.user
    (gitignored) next to this file with your own <ValheimDir> / <ValheimServerDir>.

    Verified on this machine 2026-08-06:
      client BepInEx 5.4.23.3 (build 21981559)
      server BepInEx 5.4.23.5 (build 21981590)
  -->
  <PropertyGroup>
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ValheimServerDir Condition="'$(ValheimServerDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim dedicated server</ValheimServerDir>

    <ValheimManaged>$(ValheimDir)\valheim_Data\Managed</ValheimManaged>
    <BepInExCore>$(ValheimDir)\BepInEx\core</BepInExCore>

    <!--
      Every build is copied here automatically. This is the r2modman test profile used to
      run the mod ("Mod Test Profile"), NOT the raw Steam install — r2modman keeps its own
      BepInEx tree per profile, so dropping the dll in the Steam folder would not be picked up.

      Set DeployToTestProfile=false to skip the copy for a build.
    -->
    <R2ModManProfile Condition="'$(R2ModManProfile)' == ''">$(AppData)\r2modmanPlus-local\Valheim\profiles\Mod Test Profile</R2ModManProfile>
    <TestProfilePlugins>$(R2ModManProfile)\BepInEx\plugins\OldWays</TestProfilePlugins>
    <DeployToTestProfile Condition="'$(DeployToTestProfile)' == ''">true</DeployToTestProfile>

    <!-- Opt-in: also copy into the raw Steam install's plugins folder. -->
    <DeployToClient Condition="'$(DeployToClient)' == ''">false</DeployToClient>
  </PropertyGroup>

  <Import Project="Directory.Build.props.user" Condition="Exists('Directory.Build.props.user')" />

</Project>
