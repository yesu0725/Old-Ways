<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>OldWays</AssemblyName>
    <RootNamespace>OldWays</RootNamespace>
    <!-- ServerSync's ConfigSync.cs needs C# 12 (file-scoped namespaces, primary constructors)
         and a nullable annotation context. 'annotations' allows ?-annotations without turning on
         null-flow warnings across our own code. -->
    <LangVersion>latest</LangVersion>
    <Nullable>annotations</Nullable>
    <Version>0.1.0</Version>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Valheim ships its own copies of everything; never emit dependency dlls. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>portable</DebugType>

    <!-- The .NET 9 SDK can target net48 with these reference assemblies. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Publicizes the game assemblies at build time so ServerSync (and later our own patches)
         can reach Valheim private members. Build-time only; nothing is redistributed. -->
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
    <!-- NOTE: do NOT add a JetBrains.Annotations package. ServerSync's [PublicAPI] /
         [UsedImplicitly] resolve from UnityEngine.CoreModule, which already ships them;
         adding the package causes CS0433 ambiguity errors. -->
  </ItemGroup>

  <!--
    Game + loader assemblies, referenced straight out of the local install.
    Private=false so none of them are copied into our output or redistributed.
  -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim" Publicize="true">
      <HintPath>$(ValheimManaged)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils" Publicize="true">
      <HintPath>$(ValheimManaged)\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>$(ValheimManaged)\assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ValheimManaged)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ValheimManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ValheimManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ValheimManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ServerSync's connect-error panel touches TMP_Text; the trial log UI (docs/06) needs it too. -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ValheimManaged)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="WarnMissingGame" BeforeTargets="BeforeBuild"
          Condition="!Exists('$(ValheimManaged)\assembly_valheim.dll')">
    <Error Text="Valheim managed assemblies not found at '$(ValheimManaged)'. Set &lt;ValheimDir&gt; in Directory.Build.props.user." />
  </Target>

  <!--
    Deploy to every target listed in Directory.Build.props. The pdb goes too, so BepInEx stack
    traces carry line numbers.

    ContinueOnError: a locked file (server running, game open) or a missing directory must not
    fail the build — the other targets still get the new dll, and the warning says which did not.
  -->
  <Target Name="DeployOldWays" AfterTargets="Build" Condition="'$(DeployAfterBuild)' == 'true'">
    <MakeDir Directories="@(OldWaysDeployTarget)" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb"
          DestinationFolder="%(OldWaysDeployTarget.Identity)"
          SkipUnchangedFiles="false"
          ContinueOnError="WarnAndContinue" />
    <Message Importance="high" Text="Deployed $(TargetFileName) -> %(OldWaysDeployTarget.Identity)" />
  </Target>

</Project>
